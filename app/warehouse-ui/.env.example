# Gọi qua dev proxy (khuyến nghị): trình duyệt gọi cùng origin, không bị CORS.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8085
# Dùng sandbox: VITE_API_PROXY_TARGET=https://sandbox.warehouse.cmsiot.net
# Gọi thẳng không qua proxy: VITE_API_BASE_URL=https://<host>/api/v1 và xoá VITE_API_PROXY_TARGET
# (backend phải cho phép origin trong ALLOWED_ORIGINS)
