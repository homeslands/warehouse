DATABASE_USERNAME=root
DATABASE_PASSWORD=<mysql-password>
DATABASE_NAME=warehouse_db
DATABASE_HOST=localhost
DATABASE_PORT=3306

PORT=8085
NODE_ENV=development
VERSION=v1

SALT_ROUNDS=10
# Hạn access token (giây)
DURATION=900
# Hạn refresh token (giây). Mỗi lần /auth/refresh phát lại token mới với đủ hạn này (không xoay
# vòng). Cũng là TTL của 2 key thu hồi trên Redis — xem docs/specs/token-revocation.md.
REFRESHABLE_DURATION=2592000

# Root user (auto-seeded on app bootstrap if not exists)
ROOT_PHONENUMBER=root
ROOT_PASSWORD=root

SESSION_SECRET=<random-long-string>
JWT_SECRET=<random-long-string>
ALLOWED_ORIGINS="http://localhost:5175"

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_USER=<gmail-address>
MAIL_PASSWORD=<gmail-app-password>
MAIL_FROM=<gmail-address>

# Google Maps
GOOGLE_MAP_API_URL=https://maps.googleapis.com/maps/api
GOOGLE_MAPS_API_KEY=<google-maps-api-key>

# Firebase Admin (service account)
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_CLIENT_EMAIL=<firebase-client-email>
FIREBASE_PRIVATE_KEY="<firebase-private-key-with-\n-escaped>"

# Redis — BẮT BUỘC: refresh token store của auth nằm ở đây (ngoài ra BullMQ cũng dùng).
# Yêu cầu `maxmemory-policy noeviction`, nếu không phiên đăng nhập sẽ bị evict ngẫu nhiên.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<redis-password>
# Logical DB riêng cho auth, tách khỏi DB của BullMQ để FLUSHDB queue không đăng xuất toàn bộ user
REDIS_AUTH_DB=1
# Giây. TTL cache RBAC (key RBAC_STORAGE/RBAC_GRANTS, cùng REDIS_AUTH_DB). Chỉ là chặn trên cho
# trường hợp sửa permission_tbl thẳng trong DB — đổi qua API thì cache bị xoá ngay. Mặc định 300.
RBAC_CACHE_TTL=300

# AWS S3 (file upload)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
AWS_BUCKET=<aws-s3-bucket-name>

# Proxy
TRUST_PROXY_COUNT=1
