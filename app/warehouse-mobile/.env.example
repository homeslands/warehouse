# Sao chép thành .env (đã bị git ignore) rồi chỉnh theo máy.
# URL đã gồm /api/<VERSION>, không có "/" cuối. Tiền tố lấy theo biến VERSION của server:
# local là v1 (/api/v1), sandbox là v1.0.0 (/api/v1.0.0). Host sandbox.warehouse... không có
# /api/v1 — gọi nhầm sẽ nhận 404 "Cannot POST".
#   iOS simulator:     http://localhost:8085/api/v1
#   Android emulator:  http://10.0.2.2:8085/api/v1
#   Máy thật:          http://<IP LAN của máy chạy API>:8085/api/v1
EXPO_PUBLIC_API_BASE_URL=https://sandbox.warehouse.cmsiot.net/api/v1.0.0
EXPO_PUBLIC_APP_VARIANT=development
APP_VARIANT=development
