# Only application code and GitHub automation belong in this repository.
# Keep this policy tracked so it also applies to fresh clones.
/*
!/.gitignore
!/.github/
!/app/

# Dependencies, generated output and caches (including nested apps).
node_modules/
dist/
dist-ssr/
build/
coverage/
.cache/
.vite/
.turbo/
*.tsbuildinfo

# Real environment files and private keys; retain safe example templates.
.env
.env.*
!.env.example
!.env.*.example
*.local
*.pem
*.key
*.p12
*.pfx

# Runtime data and logs, never source assets or database migrations.
logs/
*.log
/app/*/public/uploads/
/app/*/public/backup/

# Local agent/editor setup and generated implementation plans.
.agents/
.claude/
.codex/
CLAUDE.md
setup.md
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
/app/*/docs/superpowers/plans/
